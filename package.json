{
  "name": "@xema/omni-protocol",
  "version": "0.1.97",
  "description": "The Omni protocol: the contract every provider adapter implements",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "files": [
    "dist",
    "README.md",
    "guide.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck && vitest run",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm run build && pnpm run test && pnpm run check:package",
    "prepublishOnly": "pnpm run check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inukollu/Omni-Protocol.git"
  }
}
